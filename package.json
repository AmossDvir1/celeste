{
  "name": "celeste",
  "version": "0.1.0",
  "private": true,
  "description": "Celeste: one desktop workbench for Claude, GitHub Copilot, OpenAI and Google Gemini",
  "keywords": ["ai", "electron", "claude", "copilot", "openai", "gemini", "agents", "desktop"],
  "homepage": "https://github.com/AmossDvir1/celeste#readme",
  "repository": { "type": "git", "url": "git+https://github.com/AmossDvir1/celeste.git" },
  "bugs": { "url": "https://github.com/AmossDvir1/celeste/issues" },
  "engines": { "node": ">=22.13" },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:persistence": "electron-vite build && node scripts/persistence-check.mjs",
    "verify:package": "electron-vite build && node scripts/package-check.mjs",
    "verify:devices": "electron-vite build && node scripts/devices-check.mjs",
    "verify:copilot": "electron-vite build && node scripts/copilot-check.mjs && node scripts/copilot-signin-check.mjs",
    "shots": "electron-vite build && node scripts/screenshots.mjs",
    "glow:compare": "electron-vite build && node scripts/glow-compare.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@xyflow/react": "^12.12.1",
    "buffer": "^6.0.3",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.70.0",
    "playwright-core": "^1.65.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.29",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bonjour-service": "^1.4.4",
    "ssh2": "^1.17.0"
  }
}
