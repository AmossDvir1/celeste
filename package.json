{
  "name": "celeste",
  "version": "0.1.0",
  "private": true,
  "description": "Celeste: your AI workbench",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:persistence": "electron-vite build && node scripts/persistence-check.mjs",
    "verify:package": "electron-vite build && node scripts/package-check.mjs",
    "shots": "electron-vite build && node scripts/screenshots.mjs",
    "glow:compare": "electron-vite build && node scripts/glow-compare.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.65.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  }
}
