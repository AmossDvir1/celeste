{
  "name": "celeste",
  "version": "1.2.0",
  "private": true,
  "description": "Celeste: one desktop workbench for Claude, GitHub Copilot, OpenAI and Google Gemini",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "electron",
    "claude",
    "copilot",
    "openai",
    "gemini",
    "agents",
    "desktop"
  ],
  "homepage": "https://github.com/AmossDvir1/celeste#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmossDvir1/celeste.git"
  },
  "bugs": {
    "url": "https://github.com/AmossDvir1/celeste/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:persistence": "electron-vite build && node scripts/persistence-check.mjs",
    "verify:package": "electron-vite build && node scripts/package-check.mjs",
    "verify:devices": "electron-vite build && node scripts/devices-check.mjs",
    "verify:checkpoints": "electron-vite build && node scripts/checkpoints-check.mjs",
    "verify:worktrees": "electron-vite build && node scripts/worktrees-check.mjs",
    "verify:terminal": "electron-vite build && node scripts/terminal-check.mjs",
    "verify:files": "electron-vite build && node scripts/files-check.mjs",
    "verify:workflows": "electron-vite build && node scripts/workflows-check.mjs",
    "verify:workflows-chat": "electron-vite build && node scripts/workflows-chat-check.mjs",
    "verify:workflows-ai": "electron-vite build && node scripts/workflows-ai-check.mjs",
    "verify:desktop": "electron-vite build && node scripts/desktop-check.mjs",
    "verify:phone": "electron-vite build && npm --prefix phone run build && node scripts/phone-check.mjs",
    "verify:relay": "node scripts/relay-check.mjs",
    "verify:watch": "node scripts/watch-check.mjs",
    "verify:browser": "electron-vite build && node scripts/browser-check.mjs",
    "verify:preview": "electron-vite build && node scripts/preview-check.mjs",
    "verify:browser-tools": "electron-vite build && node scripts/browser-tools-check.mjs",
    "verify:mcp": "electron-vite build && node scripts/mcp-check.mjs",
    "verify:perf": "electron-vite build && node scripts/perf-check.mjs",
    "verify:ui": "electron-vite build && node scripts/ui-check.mjs",
    "verify:claude": "electron-vite build && node scripts/claude-check.mjs",
    "verify:openai": "node scripts/openai-check.mjs",
    "verify:openai-app": "electron-vite build && node scripts/openai-app-check.mjs",
    "verify:copilot": "electron-vite build && node scripts/copilot-check.mjs && node scripts/copilot-signin-check.mjs",
    "shots": "electron-vite build && node scripts/screenshots.mjs",
    "glow:compare": "electron-vite build && node scripts/glow-compare.mjs",
    "icons": "node scripts/make-icons.mjs",
    "notices": "node scripts/notices.mjs",
    "dist:dir": "electron-vite build && node scripts/stage.mjs && electron-builder --config.directories.app=release/stage --dir --publish never",
    "dist:win": "electron-vite build && node scripts/stage.mjs && electron-builder --config.directories.app=release/stage --win --publish never",
    "dist:mac": "electron-vite build && node scripts/stage.mjs && electron-builder --config.directories.app=release/stage --mac --publish never",
    "installer-check": "node scripts/installer-check.mjs",
    "mock:phone": "node scripts/phone-mock.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.10.2",
    "axe-core": "^4.14.0",
    "buffer": "^6.0.3",
    "docx-preview": "^0.4.1",
    "electron": "^45.2.3",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron-vite": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "1.6.0",
    "@github/copilot-sdk": "1.0.29",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bonjour-service": "^1.4.4",
    "koffi": "3.3.4",
    "node-datachannel": "^0.33.6",
    "playwright-core": "^1.65.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.2"
  },
  "author": "The Celeste contributors"
}
