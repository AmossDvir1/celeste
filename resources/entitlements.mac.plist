<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's JavaScript engine needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Celeste starts programs it downloaded (Claude Code, Copilot's runtime) and a pty, which are not signed with Celeste's certificate. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Local network: finding computers and phones to use as devices. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
