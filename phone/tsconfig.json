{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@/*": ["../src/renderer/*"]
    }
  },
  "include": ["src", "../src/shared/phone.ts", "../src/shared/phone-client.ts", "../src/renderer/stores/reduce.ts"]
}
